# ── Anthropic ──────────────────────────────────────────────────────────────
ANTHROPIC_API_KEY=sk-ant-...

# ── Security ───────────────────────────────────────────────────────────────
# 32-byte hex key for AES-256-GCM credential encryption
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
ENCRYPTION_KEY=your_32_byte_hex_key_here

# JWT signing secret — generate with: openssl rand -hex 32
JWT_SECRET_KEY=your_jwt_secret_here

# ── App ────────────────────────────────────────────────────────────────────
APP_ENV=development
DATABASE_URL=sqlite+aiosqlite:///./data/tablebridge.db
FRONTEND_ORIGIN=http://localhost:5173

# ── Mock Platform Webhook Secrets ──────────────────────────────────────────
DOORDASH_WEBHOOK_SECRET=mock_doordash_secret_abc123
UBEREATS_WEBHOOK_SECRET=mock_ubereats_secret_def456
GRUBHUB_WEBHOOK_SECRET=mock_grubhub_secret_ghi789

# ── Demo Mode ──────────────────────────────────────────────────────────────
DEMO_MODE=true
DEMO_ORDER_INTERVAL_MIN=30
DEMO_ORDER_INTERVAL_MAX=90
